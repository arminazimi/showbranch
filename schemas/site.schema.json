{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/arminazimi/repobloom/main/schemas/site.schema.json",
  "title": "RepoBloom Site",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "projects"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "handle", "profileUrl"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "handle": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
        "bio": { "type": "string" },
        "location": { "type": "string" },
        "avatarUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "profileUrl": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
        "websiteUrl": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "stars", "topics"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
          "homepageUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "language": { "type": "string" },
          "stars": { "type": "integer", "minimum": 0 },
          "topics": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
